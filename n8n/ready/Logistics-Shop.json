    {
      "parameters": {
        "jsCode": "const TOLERANCE = 0.01;\nreturn $input.all().map((entry) => {\n  const order = entry.json;\n  const errors = [];\n\n  // Customer and address\n  if (!order.customer || !order.customer.email) errors.push('Missing customer or email');\n  const addr = order.shipping_address || {};\n  if (!addr.street || !addr.city || !addr.postal_code || !addr.country) errors.push('Incomplete shipping address');\n\n  // 1. Order status: only ready_for_shipment can be shipped\n  if (!['ready_for_shipment','packing'].includes(order.status)) {\n    errors.push('Invalid order status: ' + (order.status || 'missing') + ' (expected ready_for_shipment)');\n  }\n\n  // 2. Products\n  const products = Array.isArray(order.products) ? order.products : [];\n  if (products.length === 0) errors.push('No products in order');\n  let computedTotal = 0;\n  products.forEach((p, i) => {\n    const item = p || {};\n    const label = 'Product #' + (i + 1) + (item.sku ? ' (' + item.sku + ')' : '');\n    if (!item.sku) errors.push(label + ': missing sku');\n    if (!item.name) errors.push(label + ': missing name');\n    const qty = Number(item.qty);\n    const qtyOk = item.qty !== undefined && item.qty !== null && item.qty !== '' && Number.isFinite(qty) && qty > 0;\n    if (!qtyOk) errors.push(label + ': quantity must be greater than 0');\n    const price = Number(item.price);\n    const priceOk = item.price !== undefined && item.price !== null && item.price !== '' && Number.isFinite(price) && price >= 0;\n    if (!priceOk) errors.push(label + ': price must be 0 or more');\n    if (qtyOk && priceOk) computedTotal += qty * price;\n  });\n  computedTotal = Math.round((computedTotal + Number(order.shipping_amount || 0)) * 100) / 100;\n\n  // 3. Order total = sum(qty x price)\n  const total = Number(order.total_amount);\n  if (!Number.isFinite(total) || total <= 0) {\n    errors.push('Total amount must be greater than 0');\n  } else if (Math.abs(computedTotal - total) > TOLERANCE) {\n    errors.push('Order total mismatch (computed ' + computedTotal.toFixed(2) + ' vs order ' + total.toFixed(2) + ')');\n  }\n\n  // 4. Payment\n  if (order.payment_status !== 'paid') errors.push('Payment not completed (payment_status: ' + (order.payment_status || 'missing') + ')');\n  if (!order.currency) errors.push('Missing currency');\n  if (order.paid_amount !== undefined && order.paid_amount !== null) {\n    const paid = Number(order.paid_amount);\n    if (!Number.isFinite(paid) || (Number.isFinite(total) && Math.abs(paid - total) > TOLERANCE)) {\n      errors.push('Paid amount mismatch (paid ' + order.paid_amount + ' vs total ' + order.total_amount + ')');\n    }\n  }\n\n  return { json: { ...order, computed_total: computedTotal, isValid: errors.length === 0, validationErrors: errors } };\n});"
      },
      "id": "fa76db09-d4f5-452c-8a8f-cdb7904e3c55",
      "name": "Validate Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2016,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json:o})=>{const errors=[...(o.validationErrors||[])];if(o.shipment)errors.push('Shipment already exists; do not send duplicate notifications');return {json:{...o,duplicate:!!o.shipment,validationErrors:errors,isValid:errors.length===0}};});"
      },
