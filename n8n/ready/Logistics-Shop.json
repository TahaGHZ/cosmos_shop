    {
      "parameters": {
        "jsCode": "// MOCK hand-off of the validated order to the Inventory & Warehouse process (DEMO).\nconst order = $json;\nconst products = (order.products || []).map((p) => ({ sku: p.sku, name: p.name, qty: Number(p.qty) }));\nconst quantities = {};\nproducts.forEach((p) => { quantities[p.sku] = p.qty; });\nreturn [{ json: {\n  order_id: order.id,\n  customer: order.customer,\n  shipping_address: order.shipping_address,\n  products,\n  quantities,\n  total_amount: order.total_amount,\n  currency: order.currency,\n  handoff_status: 'sent_to_warehouse',\n  sent_at: new Date().toISOString(),\n} }];"
      },
