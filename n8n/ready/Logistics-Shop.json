    {
      "parameters": {},
      "id": "3824894a-e937-46ef-9f22-0d16f3b314d6",
      "name": "Test Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -2464,
        832
      ]
