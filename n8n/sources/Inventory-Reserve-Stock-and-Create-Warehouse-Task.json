      "parameters": {
        "jsCode": "const lines = $('Split Out Items').all().map(i => i.json);\nconst rows = $input.all().map(i => i.json);\n\nconst out = lines.map(l => {\n  const p = rows.find(r => r.sku === l.sku) || {};\n  const qty = Number(l.qty);\n  const available = Number(p.available ?? 0);\n  const reserved = Number(p.reserved ?? 0);\n  return { sku: l.sku, qty, reserved, available, ok: !!p.sku && available >= qty };\n});\n\nconst all_ok = out.every(o => o.ok);\nreturn out.map(o => ({ json: { ...o, all_ok } }));"
      },
