      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cfg=$('OH Followup Configuration').first().json;const orders=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]);return orders.filter(o=>o.status==='awaiting_confirmation').flatMap(o=>{const hours=(Date.now()-Date.parse(o.createdAt))/3600000;if(hours>=cfg.reviewAfterHours){if(o.reviewReason==='Customer has not confirmed within '+cfg.reviewAfterHours+' hours')return [];return [{json:{id:o.id,action:'escalate',body:{reason:'Customer has not confirmed within '+cfg.reviewAfterHours+' hours'}}}];}if(hours>=cfg.remindAfterHours&&(!o.lastReminderAt||Date.now()-Date.parse(o.lastReminderAt)>=86400000))return [{json:{id:o.id,action:'remind',body:{}}}];return [];});"
