      "name": "OH Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const event=$input.first().json.body||{};\nif(!event.order_id && !event.order?.id) return [];\nif(event.type && !['order.created','order.validated','order.confirmed','order.cancelled','order.shipped','shipment.updated','payment.reconciled','inventory.reserved','warehouse.ready','warehouse.updated','order.review_required'].includes(event.type))return [];\nreturn [{json:{event,orderId:String(event.order_id||event.order.id),shopBaseUrl:'http://host.docker.internal:3000',logisticsWebhookUrl:'SET_LOGISTICS_PRODUCTION_WEBHOOK_URL'}}];"
      },
      "position": [
