      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const o=$input.first().json;const event=$('OH Configuration').first().json.event;let handlerAction='sync';if(o.processing_status==='received'&&(!event.type||event.type==='order.created'))handlerAction='validate';if(o.processing_status==='confirmed'&&event.type==='order.confirmed'&&!o.logisticsHandoff?.acceptedAt)handlerAction='handoff';return [{json:{...o,handlerAction}}];"
