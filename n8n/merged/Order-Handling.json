    {
      "id": "bacad543-d43c-48fa-b140-c959b5d1a8da",
      "name": "OH Validate Customer Payment Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const o=$('OH Decide').first().json;const errors=[];if(!o.customer?.name||! /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(o.customer?.email||''))errors.push('Customer details missing');if(!o.shipping_address?.street||!o.shipping_address?.city||!o.shipping_address?.postal_code||!o.shipping_address?.country)errors.push('Complete shipping address required');if(!Array.isArray(o.products)||!o.products.length)errors.push('No products');for(const p of o.products||[])if(!p.sku||!Number.isInteger(p.qty)||p.qty<1||!Number.isFinite(p.price)||p.price<0)errors.push('Invalid item: '+(p.sku||'unknown'));const total=(o.products||[]).reduce((s,p)=>s+p.qty*p.price,0)+Number(o.shipping_amount||0);if(!Number.isFinite(total)||Math.abs(total-o.total_amount)>.01)errors.push('Total does not match items and shipping');if(o.payment_status!=='paid'||Math.abs(o.paid_amount-o.total_amount)>.01)errors.push('Payment requires human review');return [{json:{order_id:o.id,valid:errors.length===0,errors}}];"
      },
      "position": [
        1440,
        0
